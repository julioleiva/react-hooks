{
  "name": "examples-course",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:a11y": "vitest run -t \"(accessibility|a11y)\"",
    "test:unit": "vitest run -t \"(unit|unit-test)\"",
    "test:int": "vitest run -t \"(int|integration)\"",
    "test:a11y-file": "vitest run AccessibleForm.a11y.test.tsx",
    "test:reporter": "vitest --reporter=verbose",
    "test:changed": "vitest changed",
    "test:typecheck": "vitest typecheck"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "react": "18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.1.7"
  },
  "devDependencies": {
    "@axe-core/react": "^4.10.1",
    "@eslint/js": "^9.25.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/ui": "^3.1.4",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
